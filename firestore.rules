rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acceso anónimo a los cuadros; el apartado de administrador usa Firebase Auth en la app.
    match /cuadros/{cuadro} {
      allow read, write: if true;
    }

    // Cada unidad educativa nueva tiene su propia colección (cuadros_<slug>).
    // El registro de unidades y sus escudos vive en config/colegios.
    match /{coleccion}/{documento} {
      allow read, write: if coleccion == 'config' || coleccion.matches('cuadros_.*');
    }

    // Todo lo demás queda bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

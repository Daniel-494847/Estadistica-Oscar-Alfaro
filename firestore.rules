rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acceso anónimo a los cuadros; el apartado de administrador usa Firebase Auth en la app.
    match /cuadros/{cuadro} {
      allow read, write: if true;
    }

    // Estructura obligatoria: reportes-academicos/<unidad>/<subcolección>/<documento>
    // Incluye exportaciones/<pdf|excel|word>/<documento> y el registro global en _registro.
    match /reportes-academicos/{unidad}/{resto=**} {
      allow read, write: if true;
    }

    // Rutas antiguas: se conservan solo para la lectura de respaldo/migración perezosa.
    match /{coleccion}/{documento} {
      allow read, write: if coleccion == 'config' || coleccion.matches('cuadros_.*');
    }

    // Todo lo demás queda bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
